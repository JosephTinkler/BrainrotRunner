{
  "name": "brainrot-runners",
  "displayName": "Brainrot Runners",
  "description": "An endless 3-lane runner inside a VS Code webview panel.",
  "version": "0.0.1",
  "publisher": "JosephTinkler",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/JosephTinkler/BrainrotRunner.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "game",
    "runner",
    "arcade",
    "endless runner",
    "brainrot",
    "fun"
  ],
  "icon": "media/icon.png",
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "brainrotRunners",
          "title": "Brainrot Runners",
          "icon": "media/sidebar-icon.svg"
        }
      ]
    },
    "views": {
      "brainrotRunners": [
        {
          "type": "webview",
          "id": "brainrotRunners.sidebar",
          "name": "Play"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "brainrotRunners.play",
          "when": "view == brainrotRunners.sidebar",
          "group": "navigation"
        }
      ]
    },
    "commands": [
      {
        "command": "brainrotRunners.play",
        "title": "Brainrot Runners: Play",
        "icon": "$(link-external)"
      },
      {
        "command": "brainrotRunners.showHighScores",
        "title": "Brainrot Runners: Show High Scores"
      },
      {
        "command": "brainrotRunners.resetHighScores",
        "title": "Brainrot Runners: Reset High Scores"
      }
    ],
    "configuration": {
      "title": "Brainrot Runners",
      "properties": {
        "brainrotRunners.sound": {
          "type": "boolean",
          "default": true,
          "description": "Play simple sound effects in the game."
        },
        "brainrotRunners.reducedMotion": {
          "type": "boolean",
          "default": false,
          "description": "Reduce screen shake and flashing effects."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "lint": "eslint .",
    "test:unit": "vitest run",
    "test:integration": "npm run build && tsc -p tsconfig.test.json && vscode-test",
    "test": "npm run test:unit && npm run test:integration",
    "package": "vsce package"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.6",
    "@types/vscode": "1.85",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "mocha": "^12.0.3",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
